[Unit]
Description=SDR AM/NFM demodulator
Documentation=https://github.com/szpajder/RTLSDR-Airband/wiki
Wants=network.target pulseaudio.service
After=network.target pulseaudio.service
PartOf=pulseaudio.service
StartLimitIntervalSec=15min
StartLimitBurst=4

[Service]
Type=simple
ExecStart=/usr/local/bin/rtl_airband -Fe
# Allow a few retries for transient SDR or PulseAudio failures, then leave the
# unit failed so a bad config or missing dongle does not spin forever.
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
