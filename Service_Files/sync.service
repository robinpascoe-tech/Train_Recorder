[Unit]
Description=Move completed train recorder MP3 files with rclone
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
Group=pi
Environment=HOME=/home/pi
Environment=XDG_CONFIG_HOME=/home/pi/.config
EnvironmentFile=-/etc/train-recorder/sync.env
ExecStart=/opt/train-recorder/Scripts/sync.sh
