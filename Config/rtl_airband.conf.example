# Example RTLSDR-Airband configuration for a two-channel railway recorder.
#
# Copy this file to your rtl_airband configuration path, usually:
#   /usr/local/etc/rtl_airband.conf
#
# Fill in your own Broadcastify/Icecast connection details before use.
# Do not commit the real config file with live passwords or mountpoints.
log_scan_activity = true;

mixers: {
  mixer1: {
    outputs: (
        {
         disable = false;
         type = "icecast";
         server = "audio9.broadcastify.com";
         port = 80;
         mountpoint = "YOUR_MOUNTPOINT";
         name = "Ontario Northland Railway - New Liskeard Tower";
         genre = "RAIL";
         username = "source";
         password = "YOUR_BROADCASTIFY_PASSWORD";
         send_scan_freq_tags = false;
         description = "Ontario Northland Railway";
        }
    );
  }
};

devices:
({
  type = "rtlsdr";
  index = 0;
  gain = 48;
  centerfreq = 160.4;
  correction = 0;
  channels:
  (
    {
      freq = 160.545;
      modulation = "nfm";
      afc = 1;
      outputs: (
        {
          type = "pulse";
          sink = "myfreq1sink";
        },
        {
          type = "mixer";
          name = "mixer1";
          ampfactor = 1.5;
        }
      );
    },
    {
      freq = 161.265;
      modulation = "nfm";
      afc = 0;
      outputs: (
        {
          type = "pulse";
          sink = "myfreq2sink";
        }
      );
    }
  );
 }
);
